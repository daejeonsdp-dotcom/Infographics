    <script>
        // --- Utility: Split Long Labels ---
        function splitLabel(label) {
            if (label.length > 16) {
                const words = label.split(' ');
                const lines = [];
                let currentLine = words[0];
                for (let i = 1; i < words.length; i++) {
                    if ((currentLine + ' ' + words[i]).length <= 16) {
                        currentLine += ' ' + words[i];
                    } else {
                        lines.push(currentLine);
                        currentLine = words[i];
                    }
                }
                lines.push(currentLine);
                return lines;
            }
            return label;
        }

        const commonTooltip = {
            callbacks: {
                title: function(tooltipItems) {
                    const item = tooltipItems[0];
                    let label = item.chart.data.labels[item.dataIndex];
                    if (Array.isArray(label)) {
                        return label.join(' ');
                    }
                    return label;
                }
            }
        };

        window.onload = function() {
            // 1. Sentiment Doughnut Chart (TJB Poll 2025.05.24 기준)
            const ctxSentiment = document.getElementById('sentimentChart').getContext('2d');
            // TJB 보도 기준 데이터: 찬성 54.5%, 반대 29.1%. 기타/무응답은 100 - 54.5 - 29.1 = 16.4%
            new Chart(ctxSentiment, {
                type: 'doughnut',
                data: {
                    labels: ['찬성 (54.5%): 통합 동력', '반대 (29.1%): 주요 저항', '기타/무응답 (16.4%): 잠재적 부동층'],
                    datasets: [{
                        data: [54.5, 29.1, 16.4],
                        backgroundColor: ['#2563eb', '#94a3b8', '#e2e8f0'], // Blue (찬성), Dark Gray (반대), Light Gray (기타)
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: commonTooltip
                    },
                    cutout: '70%'
                }
            });

            // 2. Radar Chart: Gov vs SDP
            const ctxRadar = document.getElementById('radarCompareChart').getContext('2d');
            const radarLabels = ['경제 규모 확대', '행정 효율성', '사회적 형평성', '민주적 절차', '공공서비스 질'].map(splitLabel);
            new Chart(ctxRadar, {
                type: 'radar',
                data: {
                    labels: radarLabels,
                    datasets: [{
                        label: '정부/여당 추진안',
                        data: [90, 85, 30, 20, 40],
                        backgroundColor: 'rgba(148, 163, 184, 0.2)',
                        borderColor: '#94a3b8',
                        pointBackgroundColor: '#94a3b8'
                    }, {
                        label: '사민당 조건부안',
                        data: [70, 75, 95, 90, 95],
                        backgroundColor: 'rgba(6, 182, 212, 0.2)',
                        borderColor: '#06b6d4',
                        pointBackgroundColor: '#06b6d4'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        r: {
                            suggestedMin: 0,
                            suggestedMax: 100,
                            ticks: { display: false }
                        }
                    },
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: commonTooltip
                    }
                }
            });

            // 3. Stacked Bar Chart: Budget Simulation
            const ctxBudget = document.getElementById('budgetSimulationChart').getContext('2d');
            const budgetLabels = ['개발 중심 통합 (현재)', '정의로운 통합 (사민당)'].map(splitLabel);
            new Chart(ctxBudget, {
                type: 'bar',
                data: {
                    labels: budgetLabels,
                    datasets: [{
                        label: '토건/인프라',
                        data: [70, 40],
                        backgroundColor: '#94a3b8'
                    }, {
                        label: '복지/의료/교육 (특별회계)',
                        data: [30, 60],
                        backgroundColor: '#2563eb'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    indexAxis: 'y',
                    scales: {
                        x: { stacked: true, max: 100 },
                        y: { stacked: true }
                    },
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: commonTooltip
                    }
                }
            });

            // 4. Plotly Bar Chart: Service Quality Index
            const trace1 = {
                x: ['교통 접근성', '의료 골든타임', '주거 안정성'],
                y: [40, 35, 45],
                name: '통합 이전 (현재)',
                type: 'bar',
                marker: { color: '#cbd5e1' }
            };
            const trace2 = {
                x: ['교통 접근성', '의료 골든타임', '주거 안정성'],
                y: [85, 90, 80],
                name: '통합 이후 (조건 충족)',
                type: 'bar',
                marker: { color: '#06b6d4' }
            };
            const layout = {
                barmode: 'group',
                margin: { t: 20, b: 40, l: 40, r: 20 },
                paper_bgcolor: 'rgba(0,0,0,0)',
                plot_bgcolor: 'rgba(0,0,0,0)',
                legend: { orientation: 'h', y: -0.2 },
                yaxis: { range: [0, 100], title: '공공성 지수' }
            };
            Plotly.newPlot('serviceQualityChart', [trace1, trace2], layout, {displayModeBar: false, responsive: true});
        };
    </script>
